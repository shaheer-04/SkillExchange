# Copy this file to .env and fill in your own values.
# The real .env file must never be committed to GitHub.

# Port the API listens on
PORT=5000

# MongoDB Atlas connection string
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillexchange?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# Long random string used to sign JWTs
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret

# How long a login stays valid
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS. Comma separated. Leave empty to allow all (development).
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development
